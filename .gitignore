# macOS / editor noise
.DS_Store
**/.DS_Store

# Python cache / bytecode
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Local runtime artefacts written by skills during use
.orchestrator/
.pm/
.claude/
HANDOFF.md

# PM ledger: per-host run files and the rendered leaderboard are local output;
# the frozen pre-ledger history table beside them is tracked
skills/project-manager/ledger/*/
skills/project-manager/ledger/leaderboard.md

# Archived/superseded content (never deleted, not tracked by default)
archive/

# Logs and transient files
*.log
*.tmp

# Other
pm-test/
